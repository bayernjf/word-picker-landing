---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ui } from '../../i18n/ui';

const lang = 'en';
const t = ui[lang];
---

<Base lang={lang} title="Terms of Service | WordPicker" description="WordPicker Terms of Service: the agreement covering use of this site and its content.">
  <Header lang={lang} />
  <main class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-white sm:text-4xl">{t.footer.legal.terms}</h1>
      <p class="mt-3 text-sm text-slate-500">Last updated: August 7, 2026</p>

      <div class="mt-10 space-y-8 text-sm leading-7 text-slate-400">
        <section>
          <h2 class="text-lg font-semibold text-white">1. Acceptance</h2>
          <p class="mt-2">
            Welcome to the WordPicker product site (the "Site"). By accessing or using the Site you agree to these terms. If you do not agree, please do not use the Site.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">2. Site Content</h2>
          <p class="mt-2">
            Content is provided "as is" for product introduction purposes and may change as the product evolves. We strive for accuracy but make no express or implied warranties regarding completeness or timeliness.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">3. Intellectual Property</h2>
          <p class="mt-2">
            The Site's copy, design, and branding belong to the project team and may not be used commercially without permission. The extension itself is distributed under the terms declared in its store listing or repository.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">4. Acceptable Use</h2>
          <p class="mt-2">
            Do not use the Site in ways that could harm or disrupt its operation or infringe on others' rights, including malicious scraping, injection attacks, or impersonation.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">5. Limitation of Liability</h2>
          <p class="mt-2">
            To the maximum extent permitted by law, the Site and the WordPicker extension are not liable for any indirect, incidental, or consequential damages arising from use of or inability to use the Site or the extension.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">6. Changes & Contact</h2>
          <p class="mt-2">
            These terms may be updated; changes will be posted here. Questions can be raised via Issues on our
            <a href="https://github.com/bayernjf/word-picker" target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300">GitHub repository</a>.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>
