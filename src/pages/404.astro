---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';
---

<Base lang={lang} title="404: Page Not Found" description="The WordPicker page you are looking for does not exist or has been moved.">
  <Header lang={lang} />
  <main class="py-24 sm:py-32">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-7xl font-extrabold text-emerald-500">404</p>
      <h1 class="mt-4 text-2xl font-bold text-white">Page Not Found</h1>
      <p class="mt-3 text-sm text-slate-400">The page you are looking for does not exist or has been moved.</p>
      <a href="/" class="mt-8 inline-flex items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-emerald-500">Back to Home</a>
    </div>
  </main>
  <Footer lang={lang} />
</Base>
