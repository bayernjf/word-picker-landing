---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].footer;
const year = new Date().getFullYear();
const homePath = lang === 'zh' ? '/zh' : '/';
---

<footer class="bg-slate-900 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <svg viewBox="0 0 64 64" class="w-8 h-8" aria-hidden="true">
            <defs>
              <linearGradient id="wpFtBL" x1="12" y1="12" x2="28" y2="52" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#fbbf24" />
                <stop offset="100%" stop-color="#f59e0b" />
              </linearGradient>
              <linearGradient id="wpFtBR" x1="36" y1="14" x2="52" y2="52" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#fcd34d" />
                <stop offset="100%" stop-color="#fbbf24" />
              </linearGradient>
              <linearGradient id="wpFtC" x1="23" y1="20" x2="41" y2="44" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#f97316" />
                <stop offset="100%" stop-color="#ea580c" />
              </linearGradient>
            </defs>
            <rect x="36" y="14" width="16" height="38" rx="3" fill="url(#wpFtBR)" />
            <rect x="12" y="12" width="16" height="40" rx="3" fill="url(#wpFtBL)" />
            <rect x="23" y="20" width="18" height="24" rx="3" fill="url(#wpFtC)" />
            <path d="M28 28h8M28 33h8M28 38h5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span class="text-white font-bold text-lg">WordPicker</span>
        </div>
        <p class="text-sm leading-relaxed max-w-md">{t.desc}</p>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-4 text-sm">{t.links.product}</h3>
        <ul class="space-y-3 text-sm">
          <li><a href={`${homePath}#features`} class="hover:text-indigo-400 transition-colors">{ui[lang].nav.features}</a></li>
          <li><a href={`${homePath}#how-it-works`} class="hover:text-indigo-400 transition-colors">{ui[lang].nav.howItWorks}</a></li>
          <li><a href={`${homePath}#showcase`} class="hover:text-indigo-400 transition-colors">{ui[lang].nav.showcase}</a></li>
          <li><a href={`${homePath}#download`} class="hover:text-indigo-400 transition-colors">{ui[lang].nav.download}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-4 text-sm">{t.links.resources}</h3>
        <ul class="space-y-3 text-sm">
          <li><a href={`${homePath}#faq`} class="hover:text-indigo-400 transition-colors">{ui[lang].nav.faq}</a></li>
          <li><a href="https://github.com/bayernjf/word-picker" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors">GitHub</a></li>
          <li><a href="https://word-base.pages.dev" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors">WordBase</a></li>
          <li><a href="https://bayjf.com" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors">BayJF</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-slate-800 text-center text-sm">
      <p>© {year} {t.copyright}</p>
      <div class="mt-3 flex items-center justify-center gap-6">
        <a href={lang === 'zh' ? '/zh/privacy' : '/privacy'} class="hover:text-indigo-400 transition-colors">{t.legal.privacy}</a>
        <a href={lang === 'zh' ? '/zh/terms' : '/terms'} class="hover:text-indigo-400 transition-colors">{t.legal.terms}</a>
      </div>
    </div>
  </div>
</footer>
