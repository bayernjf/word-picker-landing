---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].faq;
---

<section id="faq" class="py-24 bg-slate-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">{t.title}</h2>
      <p class="text-lg text-slate-600">{t.subtitle}</p>
    </div>

    <div class="space-y-4">
      {t.items.map((item) => (
        <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden hover:border-indigo-200 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left font-semibold text-slate-900 list-none">
            <span>{item.q}</span>
            <span class="ml-4 flex-shrink-0 w-6 h-6 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 group-open:rotate-45 transition-transform">
              <span class="text-lg leading-none">+</span>
            </span>
          </summary>
          <div class="px-6 pb-5 text-slate-600 leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
