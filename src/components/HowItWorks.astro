---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].howItWorks;
---

<section id="how-it-works" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">{t.title}</h2>
      <p class="text-lg text-slate-600">{t.subtitle}</p>
    </div>

    <div class="relative">
      <div class="hidden md:block absolute top-24 left-1/2 -translate-x-1/2 w-2/3 h-0.5 bg-gradient-to-r from-transparent via-emerald-200 to-transparent"></div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 relative">
        {t.steps.map((step) => (
          <div class="text-center">
            <div class="relative inline-flex items-center justify-center w-20 h-20 mb-6">
              <div class="absolute inset-0 rounded-full bg-emerald-500/15 blur-xl"></div>
              <div class="relative w-20 h-20 rounded-full bg-white border-2 border-emerald-200 flex items-center justify-center">
                <span class="text-2xl font-bold text-emerald-700">{step.num}</span>
              </div>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{step.title}</h3>
            <p class="text-slate-600 leading-relaxed max-w-xs mx-auto">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
