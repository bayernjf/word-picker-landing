---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].features;

const iconMap: Record<string, string> = {
  hover: '🖱️',
  cloud: '☁️',
  srs: '🔁',
  ai: '🤖',
  fireworks: '🎆',
  offline: '📡',
};
---

<section id="features" class="py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">{t.title}</h2>
      <p class="text-lg text-slate-600">{t.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {t.items.map((item) => (
        <div class="group bg-white rounded-2xl p-8 border border-slate-200 hover:border-indigo-300 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform">
            {iconMap[item.icon]}
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">{item.title}</h3>
          <p class="text-slate-600 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
